{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelsena/turbo/schemas/graph-release-config.schema.json",
  "title": "Turbo cumulative Market Graph release configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_name",
    "source_universe_run_id",
    "as_of_utc",
    "activations",
    "prohibited_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "release_name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "source_universe_run_id": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{20}$"
    },
    "as_of_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "activations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "activation_id",
              "activation_dir",
              "activation_config",
              "activation_config_sha256",
              "events_sha256",
              "projection_sha256"
            ],
            "properties": {
              "activation_id": {
                "type": "string",
                "pattern": "^boundary-activation-[0-9a-f]{20}$"
              },
              "activation_dir": {
                "type": "string",
                "pattern": "\\S"
              },
              "activation_config": {
                "type": "string",
                "pattern": "\\S"
              },
              "activation_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "events_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "projection_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "activation_id",
              "activation_dir",
              "activation_config",
              "activation_config_sha256",
              "events_sha256",
              "projection_sha256",
              "kind"
            ],
            "properties": {
              "activation_id": {
                "type": "string",
                "pattern": "^batch-activation-[0-9a-f]{20}$"
              },
              "activation_dir": {
                "type": "string",
                "pattern": "\\S"
              },
              "activation_config": {
                "type": "string",
                "pattern": "\\S"
              },
              "activation_config_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "events_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "projection_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "kind": {
                "const": "batch"
              }
            }
          }
        ]
      }
    },
    "prohibited_actions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "target-universe filtering",
          "market evaluation or scoring",
          "company discovery or evaluation",
          "model invocation"
        ]
      }
    }
  }
}
