{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelsena/turbo/schemas/batch-registry.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "registry_id",
        "kind",
        "registry_path",
        "created_at_utc",
        "schema_sha256",
        "implementation_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "mode": {
          "const": "simulation_only"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^batch-registry:[0-9a-f]{32}$"
        },
        "kind": {
          "const": "registry"
        },
        "registry_path": {
          "type": "string",
          "minLength": 1
        },
        "created_at_utc": {
          "type": "string",
          "minLength": 1
        },
        "schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "registry_id",
        "kind",
        "registry_sha256",
        "authorization_sha256",
        "journal_path",
        "claimed_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "mode": {
          "const": "simulation_only"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^batch-registry:[0-9a-f]{32}$"
        },
        "kind": {
          "const": "claim"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "journal_path": {
          "type": "string",
          "pattern": "^journals/[0-9a-f]{64}$"
        },
        "claimed_at_utc": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "registry_id",
        "kind",
        "registry_sha256",
        "authorization_sha256",
        "claim_sha256",
        "opened_event_sha256",
        "ready_at_utc"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "mode": {
          "const": "simulation_only"
        },
        "registry_id": {
          "type": "string",
          "pattern": "^batch-registry:[0-9a-f]{32}$"
        },
        "kind": {
          "const": "ready"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authorization_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "opened_event_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ready_at_utc": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
