{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelsena/turbo/schemas/batch-primary-output.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "role_id",
    "request_id",
    "invocation_id",
    "context_sha256",
    "output_schema_sha256",
    "prompt_sha256",
    "families"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "contract_version": {
      "const": "batch-primary-v1"
    },
    "role_id": {
      "const": "batch_primary"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^invocation:[0-9a-f]{24}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/family"
      }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "preparation_id",
        "input_pack_sha256",
        "analysis_summary",
        "proposed_markets",
        "identity_dispositions",
        "candidate_dispositions",
        "research_gaps"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 12000
        },
        "preparation_id": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 12000
        },
        "input_pack_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analysis_summary": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 12000
        },
        "proposed_markets": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/proposal"
          }
        },
        "identity_dispositions": {
          "type": "array",
          "maxItems": 96,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "candidate_dispositions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "research_gaps": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "canonical_name",
        "definition",
        "boundary",
        "dimensions",
        "explicit_exclusions",
        "related_graph_market_ids",
        "supporting_evidence_ids",
        "counterevidence_ids"
      ],
      "properties": {
        "proposal_id": {
          "type": "string",
          "pattern": "^proposal:[0-9a-f]{16}:[a-z0-9][a-z0-9-]{0,63}$"
        },
        "canonical_name": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 12000
        },
        "definition": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 12000
        },
        "boundary": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 12000
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buyer",
            "job",
            "delivery",
            "workforce",
            "economics_risk",
            "acquisition_universe",
            "ambient_ai_workflow"
          ],
          "properties": {
            "buyer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "evidence_label",
                "confidence",
                "supporting_evidence_ids",
                "counterevidence_ids"
              ],
              "properties": {
                "statement": {
                  "type": "string",
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "evidence_label": {
                  "enum": [
                    "fact",
                    "inference",
                    "assumption",
                    "unknown"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "supporting_evidence_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^evidence:[0-9a-f]{64}$"
                  },
                  "maxItems": 20000,
                  "minItems": 1
                },
                "counterevidence_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^evidence:[0-9a-f]{64}$"
                  },
                  "maxItems": 20000
                }
              }
            },
