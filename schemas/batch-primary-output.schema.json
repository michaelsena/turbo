          },
          "maxItems": 20000
        },
        "gap_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^gap:"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_market_id",
        "disposition",
        "proposal_ids",
        "rationale",
        "evidence_label",
        "confidence",
