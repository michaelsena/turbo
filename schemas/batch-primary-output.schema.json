    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_id",
        "disposition",
        "proposal_ids",
        "rationale",
        "evidence_label",
        "confidence",
        "supporting_evidence_ids",
        "counterevidence_ids",
        "gap_id"
      ],
      "properties": {
        "identity_id": {
          "type": "string",
          "pattern": "^identity:"
        },
        "disposition": {
          "enum": [
            "map_to_proposals",
            "provisional_map_to_proposals",
            "no_mapping_to_family",
            "non_market_source_identity",
            "unresolved"
          ]
        },
        "proposal_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
