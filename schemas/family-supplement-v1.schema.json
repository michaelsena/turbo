{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "family_id",
    "source_run_id",
    "sources",
    "claims",
    "gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "path",
          "url",
          "retrieved_at_utc",
          "sha256",
          "representation",
          "subject_ids"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at_utc": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "representation": {
            "enum": [
              "full_text",
              "excerpt",
              "excerpt_with_paraphrase"
            ]
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "kind",
          "text",
          "subject_ids",
          "source_ids",
          "gap_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "fact",
              "inference",
              "assumption",
              "unknown"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "gap_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id",
          "question",
          "subject_ids"
        ],
        "properties": {
          "gap_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    }
  }
}
