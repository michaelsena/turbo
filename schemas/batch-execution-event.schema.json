{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/michaelsena/turbo/schemas/batch-execution-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "at_utc",
    "authorization_sha256",
    "previous_sha256",
    "kind",
    "data",
    "sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "at_utc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authorization_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "opened",
        "reserved",
        "dispatched",
        "settled",
        "unresolved",
        "released"
      ]
    },
    "data": {
      "type": "object"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
