  "canary_reproducer": "import hashlib,json,subprocess,tempfile\nfrom datetime import datetime,timedelta,timezone\nfrom pathlib import Path\nfrom turbo.agents.batch_authorization import build_authorization,canonical_bytes\nfrom turbo.agents.batch_execution import BatchExecution,validate_execution\nfrom turbo.universe.family_pack_v2 import prepare_family_v2\nroot=Path.cwd()\nsha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()\nnow=datetime.now(timezone.utc)\nstamp=lambda d:d.isoformat().replace('+00:00','Z')\nclock=[stamp(now)]\nfamilies=['family:coverage:napcs-collection:10:001','family:coverage:prior-candidate:global-challenger:001']\nwith tempfile.TemporaryDirectory(prefix='turbo-batch-canary-') as raw:\n base=Path(raw)\n preps=[Path(prepare_family_v2(fid,root=root,output_root=base/'preparations')['preparation_path']) for fid in families]\n auth=build_authorization(preps,root=root,authorized_by='simulation-verification-no-spend',valid_from_utc=stamp(now-timedelta(minutes=1)),expires_at_utc=stamp(now+timedelta(hours=1)),prompt_sha256=hashlib.sha256(b'simulation-only acceptance').hexdigest(),pricing={'input_microusd_per_token':1,'output_microusd_per_token':2},max_cost_microusd=320,max_calls=2,max_retries=1,max_input_tokens=100,max_output_tokens=100)\n ledger=BatchExecution(base/'execution',auth,preps,root=root,clock=lambda:clock[0])\n calls=[]\n def transport(envelope):\n  calls.append([f['family_id'] for f in envelope['families']])\n  return {'outcome':'failed' if len(calls)==1 else 'succeeded','output':{'simulation':True},'usage':{'input_tokens':10,'output_tokens':5}}\n ledger.reserve('initial','worker')\n ledger.dispatch('initial','worker',transport)\n ledger.reserve('retry','worker',retry_of='initial')\n assert ledger.status()['committed_microusd']+ledger.status()['outstanding_microusd']==320\n ledger.dispatch('retry','worker',transport)\n before=(base/'execution/events.jsonl').read_bytes()\n resumed=BatchExecution(base/'execution',auth,preps,root=root,clock=lambda:clock[0])\n resumed.dispatch('retry','worker',transport)\n resumed.recover_expired()\n assert (base/'execution/events.jsonl').read_bytes()==before\n assert calls==[families,families]\n result=validate_execution(base/'execution',preps,root=root)\n assert result['valid'] and result['committed_microusd']==40 and result['outstanding_microusd']==0\n receipt={'executed_at_utc':stamp(datetime.now(timezone.utc)),'local_code_commit':subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(),'mode':'simulation_only','model_invoked':False,'transport_calls':len(calls),'families':families,'authorization':auth,'events':[json.loads(line) for line in before.splitlines()],'replay':result,'preparation_file_sha256':{p.name:{f.name:sha(f) for f in p.iterdir()} for p in preps},'journal_file_sha256':{p.name:sha(p) for p in (base/'execution').iterdir() if p.is_file() and p.name!='.lock'},'repeated_resume_byte_identical':True}\n Path('/tmp/turbo-batch-canary-result.json').write_text(json.dumps(receipt,indent=2)+'\\n')\n print(json.dumps({'valid':True,'families':len(families),'simulation_transport_calls':len(calls),'committed_microusd':40,'byte_identical_resume':True}))\n",
